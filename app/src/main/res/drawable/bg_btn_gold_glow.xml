<?xml version="1.0" encoding="utf-8"?>
<!-- btn gold m3a (glow) gold -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- eli melbara (akthar chfafa) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFB830" />
            <corners android:radius="52dp" />
        </shape>
    </item>

    <!--  wosta -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FFB830" />
            <corners android:radius="48dp" />
        </shape>
    </item>

    <!-- 9riba lel btn -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFB830" />
            <corners android:radius="44dp" />
        </shape>
    </item>

    <!-- el btn nafsou (gradient gold) -->
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/gold_dark"
                android:startColor="@color/gold" />
            <corners android:radius="40dp" />
        </shape>
    </item>
