<?xml version="1.0" encoding="utf-8"?>
<!-- chip mta3 motif: gold ki yekhtar, azra9 ki la -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_soft" />
            <stroke
                android:width="2dp"
                android:color="@color/gold" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</selector>
