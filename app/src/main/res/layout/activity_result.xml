<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Background Vari: (taswira tetbadel bel code java betbi3a) -->
    <ImageView
        android:id="@+id/img_bg_aj"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/approved" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#89000000" />

    <!-- Content on top of background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Verdict icon -->
        <ImageView
            android:id="@+id/img_verdict_aj"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/app_title"
            android:src="@drawable/ic_check" />

        <!-- Verdict title -->
        <TextView
            android:id="@+id/txt_verdict_title_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:text="@string/voyage_approved"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Message -->
        <TextView
            android:id="@+id/txt_message_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- New traveler -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_nouveau_aj"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_btn_white_outline"
            android:text="@string/new_traveler"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>