<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background_dark">

    <!-- taswiret l passport 30% -->

    <ImageView
        android:id="@+id/img_passport_aj"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@android:drawable/ic_menu_myplaces"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:background="@color/background_card"
        android:contentDescription="@string/passport_title"
        android:tint="@color/white" />

    <!-- ma3loumet l voyageur 70% -->

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="14dp">

        <!-- titre l passport -->

        <TextView
            android:id="@+id/txt_passport_title_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/passport_title"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <!-- esm l msefer -->

        <TextView
            android:id="@+id/txt_nom_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_passport_title_aj"
            android:layout_marginTop="35dp"
            android:text="@string/traveler_name"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- 3am lwileda -->

        <TextView
            android:id="@+id/txt_naissance_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_nom_aj"
            android:layout_marginTop="22dp"
            android:text="@string/birth_year"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- lwin mechy -->

        <TextView
            android:id="@+id/txt_destination_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_naissance_aj"
            android:layout_marginTop="22dp"
            android:text="@string/destination_year"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- temporal age -->

        <TextView
            android:id="@+id/txt_age_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_destination_aj"
            android:layout_marginTop="22dp"
            android:text="@string/temporal_age"
            android:textColor="@color/primary_light"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- lweh -->

        <TextView
            android:id="@+id/txt_motif_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_age_aj"
            android:layout_marginTop="22dp"
            android:text="@string/travel_purpose"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ektichef ekhtilef -->

        <TextView
            android:id="@+id/txt_paradox_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_motif_aj"
            android:layout_marginTop="25dp"
            android:text="@string/paradox_title"
            android:textColor="@color/primary_light"
            android:textStyle="bold"
            android:textSize="13sp" />

        <!-- e9bel  -->

        <Button
            android:id="@+id/btn_approuver_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_refuser_aj"
            android:layout_marginBottom="12dp"
            android:text="@string/approve"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/primary" />

        <!-- orfodh -->

        <Button
            android:id="@+id/btn_refuser_aj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/refuse"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/danger" />

    </RelativeLayout>

</LinearLayout>
